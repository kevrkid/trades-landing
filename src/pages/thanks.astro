---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { biz, telHref, smsHref } from '../lib/derive.ts';
---
<Base title="Got it, thanks" description="Your request was sent." noindex>
  <main class="sec"><div class="wrap max-w-xl! grid gap-4">
    <h1 class="sec-title text-[2.8rem]">Got it, thanks!</h1>
    <p class="text-lg">Your request is on its way to me.{biz.phone && ' Photos help me give you a real number faster, so feel free to text them.'}</p>
    {biz.phone && <a class="btn btn-go" href={smsHref('Hi! I just sent a quote request. Here are some photos:')}><Icon name="text" />Text me photos</a>}
    {biz.phone && <a class="btn btn-line" href={telHref}><Icon name="call" />Call</a>}
    {biz.phone && <a class="btn btn-line" href="/contact.vcf">Save my number</a>}
    <p><a class="textlink" href="/">Back to home</a></p>
  </div></main>
  <Footer />
</Base>
