---
// Freight brand (name in src/data/freight.ts): job-site delivery, from reference/chalkline-freight-reference.html.
// Brand wording lives in src/data/freight.ts; contact, USDOT and the van come from business.ts.
import Brand from '../layouts/Brand.astro';
import Icon from '../components/Icon.astro';
import FreightForm from '../components/FreightForm.astro';
import { biz, telHref, smsHref, phoneDisplay, priceText, siteUrl, saferUrl, usdot } from '../lib/derive.ts';
import { freight as F } from '../data/freight.ts';
import markSvg from '../assets/elektrx-mark.svg?raw';

const lb = biz.name || 'Locker Box';
// Locker Box trade services, minus its own freight runs (this page covers those).
const services = biz.trades.flatMap((t) => t.services).filter((s) => !/freight/i.test(s.name));
const insured = F.insurance;
const hours = biz.hours.map((h) => `${h.days}: ${h.time}`).join(' · ');
const van = biz.van;
const year = new Date().getFullYear();
const operated = `${F.name}, operated by ${lb}.${usdot() ? ` USDOT ${usdot()}.` : ''}`;
const listText = (xs: string[]) => xs.length > 1 ? xs.slice(0, -1).join(', ') + ', and ' + xs.at(-1) : xs.join('');
const pickupBits = [F.showPhotoProof && 'Photo at pickup', F.showTextUpdates && 'text updates on the way'].filter(Boolean) as string[];
const pickupLine = pickupBits.length ? pickupBits.join(' and ') + '.' : 'Loaded and driven to your site.';
const deliveredLine = F.showPhotoProof ? 'Photo proof of delivery sent to you right away.' : F.showTextUpdates ? 'You get a text as soon as it’s delivered.' : 'Delivered to your site and signed for.';
const url = siteUrl();
const C = F.cargo;
/** 174 -> "14 ft 6 in". */
const ft = (i: number) => `${Math.floor(i / 12)} ft${i % 12 ? ` ${i % 12} in` : ''}`;
// Logo: the front of the van (Sprinter-style roof, windshield, hood slits, swept headlights, grille) with an
// orange circuit trace from headlight to headlight through a charge node. Source: src/assets/elektrx-mark.svg.
const mark = (size: number) => markSvg.replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" `);
const description = `Hot shot, same-day, scheduled and dedicated-route cargo van delivery of parts and materials to job sites across the Texas Triangle. Based in Leander, Texas.${usdot() ? ` USDOT ${usdot()}.` : ''}`;
const ld = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', name: F.name, description,
  ...(url ? { url: url + F.path } : {}),
  ...(biz.phone ? { telephone: biz.phone } : {}), ...(biz.email ? { email: biz.email } : {}),
  areaServed: F.sameDay.map((name) => ({ '@type': 'City', name })),
  parentOrganization: { '@type': 'Organization', name: lb, ...(url ? { url: url + '/' } : {}) },
};
const faq = [
  ['How far do you go?', `Same-day across the Texas Triangle: ${listText(F.sameDay.filter((c) => c !== 'Leander' && c !== 'Cedar Park' && c !== 'Hutto'))}. ${listText(F.byArrangement)} by arrangement.`],
  ['How fast can you get here?', 'Call or text any day, including early starts, and you’ll get a pickup time when you book. Hot shot runs go straight from pickup to your site.'],
  ['What fits in the van?', `Up to 3 pallets or 2,300 lb, with ${van.cargoVolume || '488 cubic feet'} of space and ${van.cargoHeight || '79 inches'} of standing height. Hazardous materials aren’t carried.`],
  ['What does it cost?', F.pricing],
  ['Is there a trip fee?', 'No trip fee within 30 miles. Beyond that, a $75 trip fee, confirmed before booking.'],
  ['How do I pay?', biz.faq.payment || 'Card, cash, or Zelle.'],
];
---
<Brand theme="cf" siteName={F.name} canonicalPath={F.path} ld={ld}
  title={`${F.name} | Same-day job-site delivery across the Texas Triangle`} description={description}>
  <header class="top">
    <div class="w">
      <a class="brand" href="#top">
        <Fragment set:html={mark(56)} />
        <span>{F.name}</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="#services">Services</a><a href="#carry">What we carry</a><a href="#van">The van</a><a href="#about">About</a><a href="/">Trade services</a>
      </nav>
      <div class="top-cta">
        {biz.phone && <a class="tel hide-sm" href={telHref}>{phoneDisplay()}</a>}
        <a class="b b-cta b-sm" href="#quote">Get a quote</a>
      </div>
    </div>
  </header>

  <main>
    <section id="top" class="navy">
      <div class="hero"><div class="w">
        <h1>{F.headline}</h1>
        <div class="copy">
          <p>{F.lead}</p>
          <div class="btns">
            <a class="b b-cta" href="#quote">Get a quote</a>
            {biz.phone && <a class="b b-ghost" href={telHref}>Call {phoneDisplay()}</a>}
          </div>
        </div>
      </div></div>
      <div class="w" style="padding-bottom:clamp(32px,4vw,56px)">
        <div class="split" style="align-items:center;gap:10px 24px;padding-top:20px;border-top:1px solid var(--navy-line)">
          <h2 style="font-size:20px;letter-spacing:0">Service area: the Texas Triangle</h2>
          <div style="display:flex;flex-wrap:wrap;gap:10px 24px;font-size:15px;font-weight:600">
            <span style="display:flex;align-items:center;gap:8px"><svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="#F26A1B" stroke="#fff" stroke-width="4"/></svg>Home base: Leander</span>
            <span style="display:flex;align-items:center;gap:8px"><svg width="40" height="14" viewBox="0 0 40 14" aria-hidden="true"><path d="M4 7 H36" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/></svg>Same-day</span>
            <span style="display:flex;align-items:center;gap:8px"><svg width="40" height="14" viewBox="0 0 40 14" aria-hidden="true"><path d="M4 7 H36" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-dasharray="0.5 13"/></svg>By arrangement</span>
          </div>
        </div>
        <div style="margin-top:12px">
          <svg viewBox="100 10 1090 545" role="img" aria-label={`Route map: same-day lines link ${listText(F.sameDay)}. ${listText(F.byArrangement)} are served by arrangement.`} style="display:block;width:100%;max-width:1000px;height:auto;margin-inline:auto">
            <defs><filter id="chalk" x="-2%" y="-10%" width="104%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="noise"/><feDisplacementMap in="SourceGraphic" in2="noise" scale="2.5" xChannelSelector="R" yChannelSelector="G"/></filter></defs>
            <g filter="url(#chalk)" fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
              <path stroke-width="5" stroke-dasharray="0.5 13" d="M760 100 L190 100"/>
              <path stroke-width="5" stroke-dasharray="0.5 13" d="M510 470 L510 532"/>
              <g stroke-width="6">
                <path d="M820 40 L760 100 L600 260 L600 380 L510 470"/><path d="M520 310 L700 310"/>
                <path d="M600 380 L950 380 L1040 470"/><path d="M510 470 L1040 470"/><path d="M1040 470 L1040 320 L820 100 L760 100"/>
              </g>
            </g>
            <g fill="#0A1F44" stroke="#fff" stroke-width="4">
              {[[190,100,8],[330,100,8],[820,40,8],[760,100,11],[600,262,8],[600,310,8],[700,310,8],[600,380,11],[700,380,8],[510,470,11],[1040,470,11],[510,532,8]].map(([x, y, r]) => <circle cx={x} cy={y} r={r}/>)}
            </g>
            <path class="tok" d="M520 310 L600 310 L600 380 L510 470 L1040 470 L1040 320 L820 100 L760 100 L600 260 L600 310 L700 310 L600 310 L520 310" fill="none" stroke="#F26A1B" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="140 1800" stroke-dashoffset="140"><animate attributeName="stroke-dashoffset" from="140" to="-1745" dur="18s" repeatCount="indefinite"/></path>
            <rect class="tok" x="-15" y="-9" width="30" height="18" rx="5" fill="#F26A1B" stroke="#fff" stroke-width="3"><animateMotion dur="18s" repeatCount="indefinite" rotate="auto" path="M520 310 L600 310 L600 380 L510 470 L1040 470 L1040 320 L820 100 L760 100 L600 260 L600 310 L700 310 L600 310 L520 310"/></rect>
            <circle cx="520" cy="310" r="15" fill="#F26A1B" stroke="#fff" stroke-width="4"/>
            <g font-family="Hanken Grotesk Variable, Hanken Grotesk, system-ui, sans-serif" font-weight="600" font-size="24" fill="#fff" paint-order="stroke" stroke="#0A1F44" stroke-width="8" stroke-linejoin="round">
              <text x="190" y="84" text-anchor="middle">West Texas</text><text x="330" y="84" text-anchor="middle">Abilene</text>
              <text x="836" y="47">Sherman</text><text x="744" y="86" text-anchor="end">Dallas–Fort Worth</text>
              <text x="616" y="276">Georgetown</text><text x="520" y="284" text-anchor="middle">Leander</text>
              <text x="712" y="300">Taylor</text><text x="612" y="338">Round Rock</text><text x="584" y="386" text-anchor="end">Austin</text>
              <text x="700" y="410" text-anchor="middle">Bastrop</text><text x="494" y="476" text-anchor="end">San Antonio</text>
              <text x="1056" y="477">Houston</text><text x="526" y="539">South Texas</text>
            </g>
            <text x="520" y="350" text-anchor="middle" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="500" font-size="19" fill="#C9D3E3" paint-order="stroke" stroke="#0A1F44" stroke-width="7">Home base</text>
          </svg>
        </div>
        <p class="mist" style="margin-top:14px;max-width:92ch">Same-day: {listText(F.sameDay)}. By arrangement: {listText(F.byArrangement)}.</p>
      </div>
    </section>

    <section style="border-bottom:1px solid var(--line)">
      <ul class="w trust" style="padding-block:22px">
        {usdot() && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><a href={saferUrl()} rel="noopener">USDOT {usdot()}</a></li>}
        {insured && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{insured}</li>}
        <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>Up to 3 pallets or 2,300 lb</li>
        {F.showPhotoProof && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7l2-3h4l2 3"/><circle cx="12" cy="13.5" r="3.5"/></svg>Photo proof of delivery</li>}
        <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Open every day</li>
      </ul>
    </section>

    <section id="services" class="band">
      <div class="w">
        <div class="split">
          <h2 class="h2">Delivery services</h2>
          <p class="lede">{F.pricing}</p>
        </div>
        <div class="rows">
          {F.services.map((s) => (
            <div class="row3"><h3>{s.name}</h3><p>{s.what}</p><p class="when"><a href="#quote" data-level={s.name} style="text-decoration:none">{s.when}</a></p></div>
          ))}
        </div>
      </div>
    </section>

    <section id="carry" class="band gray">
      <div class="w">
        <div class="split">
          <h2 class="h2">What we carry</h2>
          <p class="lede" style="max-width:50ch">If it fits in a high-roof cargo van and isn’t hazardous, it can usually move the same day.</p>
        </div>
        <div class="cols" style="--min:230px;margin-top:28px;gap:24px 32px">
          {F.carry.map((c) => <div class="list"><h3>{c.name}</h3><ul>{c.items.map((i) => <li>{i}</li>)}</ul></div>)}
        </div>
      </div>
    </section>

    <section id="industries" class="band">
      <div class="w">
        <h2 class="h2">Industries we serve</h2>
        <div class="cols" style="--min:300px;margin-top:28px;gap:0 40px">
          {F.industries.map((i) => <div class="ind"><h3>{i.name}</h3><p>{i.what}</p></div>)}
        </div>
      </div>
    </section>

    <section id="how" class="band gray">
      <div class="w">
        <h2 class="h2">How it works</h2>
        <ol class="steps">
          <li><span class="n" aria-hidden="true">1</span><h3>Request a quote</h3><p>Pickup, drop-off, timing, and what’s moving.</p></li>
          <li><span class="n" aria-hidden="true">2</span><h3>Confirm your rate</h3><p>Price and pickup time set before anything moves.</p></li>
          <li><span class="n" aria-hidden="true">3</span><h3>Picked up</h3><p>{pickupLine}</p></li>
          <li><span class="n" aria-hidden="true">4</span><h3>Delivered</h3><p>{deliveredLine}</p></li>
        </ol>
      </div>
    </section>

    <section id="van" class="band">
      <div class="w cols" style="--min:460px;align-items:center;gap:32px clamp(28px,4vw,56px)">
        <div style="border:1px solid var(--line);border-radius:10px;padding:clamp(12px,2vw,24px)">
          <svg viewBox="0 0 680 330" role="img" aria-label={`Side drawing of the 2025 eSprinter: cargo floor ${ft(C.length)} long, ${ft(C.height)} tall inside, 488 cubic feet, room for 3 pallets or 2,300 pounds, 170-inch wheelbase`} style="display:block;width:100%;height:auto">
            <g fill="none" stroke="#0A1F44" stroke-width="2" stroke-linecap="round"><path d="M250 30 L622 30 M250 22 L250 38 M622 22 L622 38"/></g>
            <path d="M58 236 L56 196 Q57 178 72 174 L112 158 L158 74 Q163 64 176 64 L612 64 Q630 64 630 82 L630 236 Z" fill="#fff" stroke="#0A1F44" stroke-width="3" stroke-linejoin="round"/>
            <rect x="250" y="80" width="372" height="146" fill="#F26A1B" opacity="0.45"/>
            <rect x="250" y="80" width="372" height="146" fill="none" stroke="#0A1F44" stroke-width="2" stroke-dasharray="6 6"/>
            <path d="M140 136 L168 86 L234 86 L234 136 Z" fill="#C9D3E3" stroke="#0A1F44" stroke-width="3" stroke-linejoin="round"/>
            <g fill="none" stroke="#0A1F44" stroke-width="2" stroke-linecap="round"><path d="M242 72 L242 230 M300 72 L300 230 M430 72 L430 230 M56 196 L80 194"/><path d="M20 276 L660 276"/><path d="M170 300 L520 300 M170 292 L170 308 M520 292 L520 308"/><path d="M600 86 L600 220 M592 86 L608 86 M592 220 L608 220"/></g>
            <path d="M118 236 A52 52 0 0 1 222 236 Z" fill="#fff" stroke="#0A1F44" stroke-width="3"/><path d="M468 236 A52 52 0 0 1 572 236 Z" fill="#fff" stroke="#0A1F44" stroke-width="3"/>
            <circle cx="170" cy="240" r="36" fill="#0A1F44"/><circle cx="170" cy="240" r="14" fill="#C9D3E3"/>
            <circle cx="520" cy="240" r="36" fill="#0A1F44"/><circle cx="520" cy="240" r="14" fill="#C9D3E3"/>
            <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" font-size="23" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="8" stroke-linejoin="round">
              <text x="436" y="20" text-anchor="middle">Floor {ft(C.length)} ({C.length} in)</text><text x="345" y="322" text-anchor="middle">170 in wheelbase</text>
              <text x="590" y="150" text-anchor="end">{ft(C.height)}</text><text x="590" y="176" text-anchor="end">tall</text><text x="420" y="122" text-anchor="middle">488 cu ft</text>
            </g>
          </svg>
        </div>
        <div style="display:flex;flex-direction:column;gap:18px">
          <h2 class="h2">The van</h2>
          <p class="lede">A 2025 Mercedes-Benz eSprinter: all-electric, quiet, and no exhaust at your site.</p>
          <dl class="spec">
            <div><dt>Vehicle</dt><dd>2025 Mercedes-Benz eSprinter, all-electric</dd></div>
            <div><dt>Wheelbase and roof</dt><dd>170 in, high roof</dd></div>
            <div><dt>Cargo floor length</dt><dd>{ft(C.length)} ({C.length} in)</dd></div>
            <div><dt>Width inside</dt><dd>{ft(C.width)} ({C.width} in); {ft(C.wheelWells)} ({C.wheelWells} in) between the wheel wells</dd></div>
            <div><dt>Standing height inside</dt><dd>{ft(C.height)} ({C.height} in)</dd></div>
            <div><dt>Cargo space</dt><dd>488 cu ft</dd></div>
            <div><dt>Rear doors</dt><dd>About {ft(C.rearDoor[0])} wide × {ft(C.rearDoor[1])} tall</dd></div>
            <div><dt>Side door</dt><dd>About {ft(C.sideDoor[0])} wide × {ft(C.sideDoor[1])} tall</dd></div>
            <div><dt>Capacity</dt><dd>3 pallets or up to 2,300 lb</dd></div>
            <div><dt>Not carried</dt><dd>Hazardous materials</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <section id="fits" class="band gray">
      <div class="w" style="display:flex;flex-direction:column;gap:24px">
        <div><h2 class="h2">What fits, in feet and inches</h2>
        <p class="lede" style="max-width:60ch">Measured inside the bare cargo area. Sheet goods lie flat between the wheel wells, and boards, pipe and conduit up to 14 feet ride on the floor with the doors closed.</p></div>
        <div class="cols" style="--min:320px">
          <figure class="card" style="margin:0"><h3 style="font-size:20px;margin-bottom:10px">3 standard pallets</h3>
            <svg viewBox="0 0 640 352" role="img" aria-label={`Floor plan from above: ${ft(C.length)} long, ${ft(C.width)} wide, ${ft(C.wheelWells)} between the wheel wells. Three 48 by 40 inch pallets in a row.`} style="display:block;width:100%;height:auto">
              <rect x="24" y="52" width="557" height="224" rx="4" fill="#fff" stroke="#0A1F44" stroke-width="3"/>
              <rect x="371" y="52" width="115" height="27" fill="#C9D3E3" stroke="#0A1F44" stroke-width="2"/><rect x="371" y="249" width="115" height="27" fill="#C9D3E3" stroke="#0A1F44" stroke-width="2"/>
              <rect x="34" y="100" width="154" height="128" rx="3" fill="#F26A1B" fill-opacity="0.3" stroke="#F26A1B" stroke-width="3"/><text x="111" y="172" text-anchor="middle" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" font-size="22">4 × 3⅓ ft</text><rect x="198" y="100" width="154" height="128" rx="3" fill="#F26A1B" fill-opacity="0.3" stroke="#F26A1B" stroke-width="3"/><text x="274" y="172" text-anchor="middle" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" font-size="22">4 × 3⅓ ft</text><rect x="361" y="100" width="154" height="128" rx="3" fill="#F26A1B" fill-opacity="0.3" stroke="#F26A1B" stroke-width="3"/><text x="438" y="172" text-anchor="middle" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" font-size="22">4 × 3⅓ ft</text>
              <g fill="none" stroke="#0A1F44" stroke-width="2" stroke-linecap="round"><path d="M24 34 H581 M24 26 V42 M581 26 V42"/><path d="M597 52 V276 M589 52 H605 M589 276 H605"/></g>
              <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="26">
                <text x="302" y="28" text-anchor="middle">{ft(C.length)} long</text>
                <text transform="translate(619 164) rotate(90)" text-anchor="middle" dy="9">{ft(C.width)}</text>
              </g>
              <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="21"><text x="24" y="308">Cab</text><text x="581" y="308" text-anchor="end">Rear doors</text></g>
            </svg>
            <figcaption style="margin:12px 0 0;font-size:16px;line-height:1.5;color:#3A4A63">Three 48 × 40 in pallets in a row, up to 2,300 lb.</figcaption>
          </figure>
          <figure class="card" style="margin:0"><h3 style="font-size:20px;margin-bottom:10px">Sheet goods and long stock</h3>
            <svg viewBox="0 0 640 352" role="img" aria-label={`Floor plan from above: ${ft(C.length)} long, ${ft(C.width)} wide, ${ft(C.wheelWells)} between the wheel wells. A 4 by 8 foot sheet lies flat between the wheel wells, and 14 foot boards or pipe run the length of the floor.`} style="display:block;width:100%;height:auto">
              <rect x="24" y="52" width="557" height="224" rx="4" fill="#fff" stroke="#0A1F44" stroke-width="3"/>
              <rect x="371" y="52" width="115" height="27" fill="#C9D3E3" stroke="#0A1F44" stroke-width="2"/><rect x="371" y="249" width="115" height="27" fill="#C9D3E3" stroke="#0A1F44" stroke-width="2"/>
              <rect x="264" y="87" width="307" height="154" rx="2" fill="#F26A1B" fill-opacity="0.3" stroke="#F26A1B" stroke-width="3"/><text x="417" y="225" text-anchor="middle" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="22">4 × 8 ft sheet</text><rect x="34" y="144" width="538" height="12" rx="2" fill="#0A1F44"/><rect x="34" y="160" width="538" height="12" rx="2" fill="#0A1F44" fill-opacity="0.7"/><text x="38" y="132" font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="22">14 ft boards or pipe</text>
              <g fill="none" stroke="#0A1F44" stroke-width="2" stroke-linecap="round"><path d="M24 34 H581 M24 26 V42 M581 26 V42"/><path d="M597 52 V276 M589 52 H605 M589 276 H605"/></g>
              <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="26">
                <text x="302" y="28" text-anchor="middle">{ft(C.length)} long</text>
                <text transform="translate(619 164) rotate(90)" text-anchor="middle" dy="9">{ft(C.width)}</text>
              </g>
              <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="21"><text x="24" y="308">Cab</text><text x="581" y="308" text-anchor="end">Rear doors</text></g>
            </svg>
            <figcaption style="margin:12px 0 0;font-size:16px;line-height:1.5;color:#3A4A63">4 × 8 ft sheets lie flat: {ft(C.wheelWells)} ({C.wheelWells} in) between the wheel wells. Floor is {C.length} in, so 14 ft (168 in) stock fits.</figcaption>
          </figure>
          <figure class="card" style="margin:0"><h3 style="font-size:20px;margin-bottom:10px">Through the back doors</h3>
            <svg viewBox="0 0 640 330" role="img" aria-label={`Rear view: the back doors open about ${ft(C.rearDoor[0])} wide and ${ft(C.rearDoor[1])} tall; inside is ${ft(C.width)} wide and ${ft(C.height)} tall`} style="display:block;width:100%;height:auto">
              <rect x="150" y="14" width="217" height="245" rx="10" fill="#fff" stroke="#0A1F44" stroke-width="3"/>
              <rect x="164" y="33" width="189" height="226" fill="#F26A1B" fill-opacity="0.25" stroke="#F26A1B" stroke-width="3" stroke-dasharray="8 6"/>
              <g fill="#0A1F44" opacity="0.85"><circle cx="258" cy="59" r="14"/><path d="M236 259 L240 81 Q258 69 276 81 L280 259 Z"/></g>
              <g fill="none" stroke="#0A1F44" stroke-width="2" stroke-linecap="round"><path d="M130 14 V259 M122 14 H138 M122 259 H138"/><path d="M150 279 H367 M150 271 V287 M367 271 V287"/></g>
              <g font-family="Hanken Grotesk Variable, system-ui, sans-serif" font-weight="600" fill="#0A1F44" paint-order="stroke" stroke="#fff" stroke-width="7" stroke-linejoin="round" font-size="26">
                <text x="118" y="136" text-anchor="end">{ft(C.height)}</text><text x="118" y="166" text-anchor="end">tall</text>
                <text x="258" y="287" text-anchor="middle">{ft(C.width)} wide</text>
                <text x="387" y="136">Doors open</text><text x="387" y="166">≈ {ft(C.rearDoor[0])}</text><text x="387" y="196">× {ft(C.rearDoor[1])}</text>
              </g>
            </svg>
            <figcaption style="margin:12px 0 0;font-size:16px;line-height:1.5;color:#3A4A63">Inside: {ft(C.width)} wide, {ft(C.height)} tall. Rear doors open about {ft(C.rearDoor[0])} × {ft(C.rearDoor[1])}; side door about {ft(C.sideDoor[0])} × {ft(C.sideDoor[1])}.</figcaption>
          </figure>
        </div>
        <p style="font-size:15px;color:#3A4A63">Sizes are for a bare cargo floor. Text a photo or the measurements of anything close and you’ll get a straight answer before pickup.</p>
      </div>
    </section>

    <section id="about" class="navy band" style="padding-block:clamp(48px,6vw,88px)">
      <div class="w cols" style="--min:420px;align-items:start;gap:32px clamp(28px,5vw,72px)">
        <div style="display:flex;flex-direction:column;gap:18px">
          <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.06">About {F.name}</h2>
          {F.about.map((p) => <p class="mist" style="font-size:18px;line-height:1.6;max-width:56ch">{p}</p>)}
          <p style="font-size:18px;font-weight:600">{operated}</p>
        </div>
        <dl class="spec">
          <div><dt>Owner</dt><dd>{biz.owner.name}</dd></div>
          <div><dt>Operated by</dt><dd>{lb}</dd></div>
          <div><dt>Based in</dt><dd>Leander, Texas</dd></div>
          {usdot() && <div><dt>USDOT</dt><dd>{usdot()}. <a href={saferUrl()} rel="noopener" style="font-weight:600">Verify on FMCSA SAFER</a></dd></div>}
          {insured && <div><dt>Insurance</dt><dd>Commercial coverage. Certificate available on request.</dd></div>}
        </dl>
      </div>
    </section>

    <section id="trades" class="band gray">
      <div class="w cols" style="--min:380px;align-items:start;gap:28px clamp(28px,5vw,72px)">
        <div style="display:flex;flex-direction:column;gap:18px">
          <h2 class="h2">Trade services by {lb}</h2>
          <p class="lede" style="max-width:46ch">Same owner, same van, for work done on site.</p>
          <a class="b b-line" href="/" style="align-self:start">See {lb} trade services</a>
        </div>
        <ul style="list-style:none;padding:0;margin:0;border-top:2px solid var(--navy)">
          {services.map((s) => (
            <li style="display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);font-size:18px;font-weight:600"><span>{s.name}</span><span style="white-space:nowrap;font-weight:500;color:var(--body)">{priceText(s.price).replace('/hour', '/hr')}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <section id="faq" class="band">
      <div class="w cols" style="--min:340px;align-items:start">
        <h2 class="h2">Common questions</h2>
        <div class="faq">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
      </div>
    </section>

    <section id="quote" class="band gray">
      <div class="w cols" style="--min:380px;align-items:start;gap:32px clamp(28px,5vw,64px)">
        <div style="display:flex;flex-direction:column;gap:18px">
          <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.06">Get a quote</h2>
          <p class="lede" style="font-size:18px;max-width:44ch">Tell us what’s moving and where. You’ll get your rate and a pickup time before anything moves.</p>
          <dl class="spec">
            {biz.phone && <div><dt>Call or text</dt><dd><a href={telHref} style="font-weight:600;text-decoration:none">{phoneDisplay()}</a></dd></div>}
            {biz.email && <div><dt>Email</dt><dd><a href={`mailto:${biz.email}`}>{biz.email}</a></dd></div>}
            {hours && <div><dt>Hours</dt><dd>{hours}. {biz.hoursNote}</dd></div>}
            <div><dt>Based in</dt><dd>Leander, Texas</dd></div>
          </dl>
        </div>
        <FreightForm />
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="w">
      <div class="cols" style="--min:220px;gap:32px 40px">
        <div class="col" style="gap:14px">
          <div style="display:flex;align-items:center;gap:10px"><Fragment set:html={mark(48)} /><span style="font-size:21px;font-weight:700">{F.name}</span></div>
          <p style="max-width:34ch">Same-day job-site delivery across the Texas Triangle. Based in Leander, Texas.</p>
        </div>
        <div class="col">
          <h3>Contact</h3>
          {biz.phone && <a href={telHref}>{phoneDisplay()}, call or text</a>}
          {biz.email && <a href={`mailto:${biz.email}`} style="overflow-wrap:anywhere">{biz.email}</a>}
          {hours && <span>{hours}</span>}
        </div>
        <div class="col">
          <h3>Service area</h3>
          <span>Austin and Central Texas</span><span>San Antonio, Houston, Dallas–Fort Worth</span><span>Statewide by arrangement</span>
        </div>
        <div class="col">
          <h3>Company</h3>
          <a href="#services">Delivery services</a><a href="/">Trade services by {lb}</a><a href="#about">About</a><a href="#quote">Get a quote</a><a href="/privacy">Privacy</a>
        </div>
      </div>
      <div class="legal">
        <span>© {year} {operated.replace(/ USDOT.*/, '')} Owner: {biz.owner.name}.</span>
        <span>{usdot() && <><a href={saferUrl()} rel="noopener" style="text-decoration:underline">USDOT {usdot()}</a>.</>} {insured && `${insured}.`}</span>
      </div>
    </div>
  </footer>

  <nav class="bar" aria-label="Contact">
    {biz.phone && <a class="b b-line" href={telHref}><Icon name="call" />Call</a>}
    {biz.phone && <a class="b b-line" href={smsHref('Hi! I need a freight quote.\n')}><Icon name="text" />Text</a>}
    <a class="b b-cta" href="#quote"><Icon name="quote" />Quote</a>
  </nav>
</Brand>
