---
// Layout for the two brand pages: Locker Box (/, /van) and the freight brand (/freight).
import '../styles/brand.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import fontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import { biz, isSample, siteUrl, todos } from '../lib/derive.ts';

interface Props {
  title: string; description: string; canonicalPath: string; theme: 'lb' | 'cf';
  siteName: string; ogImage?: string; ld?: Record<string, unknown> | null; bar?: boolean;
}
const { title, description, canonicalPath, theme, siteName, ogImage = '', ld = null, bar = true } = Astro.props;
const url = siteUrl();
const canonical = url ? url + (canonicalPath === '/' ? '/' : canonicalPath) : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {(isSample || todos().some((t) => t.blocker)) && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0A1F44" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    {canonical && <meta property="og:url" content={canonical} />}
    {url && ogImage && <meta property="og:image" content={url + ogImage} />}
    {url && ogImage && <meta property="og:image:width" content="1200" />}
    {url && ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)}></script>}
    {biz.cloudflareAnalyticsToken && !isSample && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: biz.cloudflareAnalyticsToken })}></script>
    )}
  </head>
  <body class={theme}>
    {isSample && <div style="background:#ffe14d;color:#000;font-weight:700;text-align:center;padding:6px 10px;font-size:15px">SAMPLE PREVIEW: made-up details, for checking the layout</div>}
    <div class={bar ? 'has-bar' : ''}><slot /></div>
  </body>
</html>
