---
// Locker Box trade services page, shown at / and at /van (the van's QR code).
// Built from reference/locker-box-trades-reference.html with the real logo, van photo, work photos and videos.
import Brand from '../layouts/Brand.astro';
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { biz, telHref, smsHref, phoneDisplay, priceText, hasForm, bookUrl, jsonLd, saferUrl, usdot, metaDescription } from '../lib/derive.ts';
import { freight } from '../data/freight.ts';

const { scan = false } = Astro.props as { scan?: boolean };
const hello = scan ? 'Hi, I scanned your van. ' : 'Hi! ';
const textHref = smsHref(`${hello}I need help with: `);
const photosHref = smsHref(`${hello}Here are photos for a quote.\nMy name:\nAddress or ZIP:\nWhat I need:\n`);
const quoteHref = hasForm ? '#quote' : textHref;
const name = biz.name || 'Locker Box';
const services = biz.trades.flatMap((t) => t.services);
const sentence = (bits: string[]) => { const t = bits.length > 1 ? bits.slice(0, -1).join(', ') + ', or ' + bits.at(-1) : bits.join(''); return t ? t[0].toUpperCase() + t.slice(1) + '.' : ''; };
const hours = biz.hours.map((h) => `${h.days}: ${h.time}`).join(' · ');
const [feature, ...rest] = biz.photos.gallery;
const faq = [
  ['Are estimates free?', biz.faq.estimates],
  ['How can I pay?', biz.faq.payment],
  ['Do you need a deposit?', biz.faq.deposits],
  ['What if I need to cancel?', biz.faq.cancellations],
  ['Is there a travel fee?', biz.faq.travelFee],
  ['Is there a minimum charge?', biz.faq.minimum],
  ['Is anything extra on top of the price?', biz.faq.extras],
].filter(([, a]) => a);
const year = new Date().getFullYear();
---
<Brand theme="lb" siteName={name} canonicalPath="/" ogImage="/og.png" ld={scan ? null : jsonLd()}
  title={`${name} | ${biz.headline}`} description={metaDescription()}>
  {scan && (
    <aside class="scan">
      <p>Thanks for scanning the van!</p>
      {biz.vanOffer.headline && <p>{biz.vanOffer.headline}</p>}
      {biz.vanOffer.terms && <p style="font-weight:400;font-size:15px">{biz.vanOffer.terms}</p>}
    </aside>
  )}

  <header class="top">
    <div class="w">
      <a class="brand" href="#top" aria-label={`${name}, back to top`}>
        {biz.logo ? <img src={biz.logo} alt={name} width="510" height="423" /> : name}
      </a>
      <nav class="nav" aria-label="Main">
        <a href={freight.path}>Freight delivery</a>
        <a href="#services">Trade services</a>
        <a href="#pricing">Pricing</a>
        <a href="#work">Recent work</a>
      </nav>
      <div class="top-cta">
        {biz.phone && <a class="tel hide-sm" href={telHref}>{phoneDisplay()}</a>}
        <a class="b b-cta b-sm" href={quoteHref}>Get a quote</a>
      </div>
    </div>
  </header>

  <main>
    <section id="top" class="navy hero">
      <div class="w">
        <h1>{biz.headline}</h1>
        <div class="copy">
          <p>On-site work across {biz.area.summary || 'Central Texas'}, with material delivery from the same van. Your rate is confirmed before work starts.</p>
          {biz.subheading && <p style="color:#fff;font-weight:600">{biz.subheading}</p>}
          {biz.rating.score && <p style="color:#fff;font-weight:600"><span aria-hidden="true">★★★★★</span> {biz.rating.score} from {biz.rating.count} {biz.rating.source} reviews</p>}
          <div class="btns">
            {biz.links.booking && <a class="b b-cta" href={biz.links.booking}><Icon name="book" />Book</a>}
            <a class={`b ${biz.links.booking ? 'b-ghost' : 'b-cta'}`} href={quoteHref}>Get a quote</a>
            {biz.phone && <a class="b b-ghost" href={photosHref}>Text photos to {phoneDisplay()}</a>}
          </div>
        </div>
      </div>
      <div class="w" style="padding-bottom:clamp(28px,3vw,36px)">
        <ul class="trust">
          {usdot() && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><a href={saferUrl()} rel="noopener">USDOT {usdot()}</a></li>}
          {biz.credentials.insurance && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>{biz.credentials.insurance}</li>}
          <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>Quiet electric van</li>
          {biz.hours.length > 0 && <li><svg class="ic" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Open every day</li>}
        </ul>
        {biz.photos.van && (
          <picture>
            {biz.photos.vanWebp && <source type="image/webp" srcset={biz.photos.vanWebp} sizes="(min-width: 1240px) 1160px, calc(100vw - 32px)" />}
            <img src={biz.photos.van} alt={biz.photos.vanAlt} width="1200" height="900" fetchpriority="high" style="display:block;width:100%;height:auto;max-height:620px;object-fit:cover;margin-top:24px;border-radius:10px" />
          </picture>
        )}
      </div>
    </section>

    <section class="gray" aria-label="Steel building drawing">
      <div class="w" style="padding-block:clamp(24px,3vw,40px)">
        <div style="overflow-x:auto">
          <svg viewBox="0 0 1200 420" role="img" aria-label="Drawing of a steel building frame with wall panels going up, a weld at the eave, and the electric van parked on site" style="display:block;width:100%;height:auto;min-width:640px">
            <defs><pattern id="rib" width="14" height="14" patternUnits="userSpaceOnUse"><path d="M7 0 V14" fill="none" stroke="#0A1F44" stroke-width="2"/></pattern></defs>
            <g fill="none" stroke="#0A1F44" stroke-linecap="round">
              <path stroke-width="2" d="M30 360 L1170 360"/>
            </g>
            <polygon points="380,360 540,360 540,132 380,170" fill="#fff"/>
            <polygon points="380,360 540,360 540,132 380,170" fill="url(#rib)" stroke="#0A1F44"/>
            <path d="M380 360 L380 170 L720 90 L1060 170 L1060 360" fill="none" stroke="#0A1F44" stroke-width="14" stroke-linecap="square"/>
            <g fill="#0A1F44">
              {[[437,157],[493,143],[550,130],[607,117],[663,103],[777,103],[833,117],[890,130],[947,143],[1003,157],[380,220],[380,270],[380,320],[1060,220],[1060,270],[1060,320]].map(([x, y]) => <circle cx={x} cy={y} r="6"/>)}
              <rect x="362" y="354" width="36" height="9"/><rect x="1042" y="354" width="36" height="9"/>
            </g>
            <path d="M1074 160 L1092 146 M1078 172 L1102 172 M1074 184 L1090 198 M1046 160 L1030 146 M1060 150 L1060 132" fill="none" stroke="#0A1F44" stroke-width="8" stroke-linecap="round"/>
            <path d="M1074 160 L1092 146 M1078 172 L1102 172 M1074 184 L1090 198 M1046 160 L1030 146 M1060 150 L1060 132" fill="none" stroke="#FFC72C" stroke-width="4" stroke-linecap="round"/>
            <circle cx="1060" cy="170" r="10" stroke="#0A1F44" fill="#FFC72C"/>
            <g transform="translate(40 244) scale(0.42)" stroke="#0A1F44" stroke-linejoin="round">
              <path d="M58 236 L56 196 Q57 178 72 174 L112 158 L158 74 Q163 64 176 64 L612 64 Q630 64 630 82 L630 236 Z" fill="#fff" stroke-width="6"/>
              <rect x="250" y="80" width="372" height="146" fill="#FFC72C" opacity="0.45" stroke="none"/>
              <path d="M140 136 L168 86 L234 86 L234 136 Z" fill="#C9D3E3" stroke-width="6"/>
              <path d="M242 72 L242 230 M300 72 L300 230 M430 72 L430 230" fill="none" stroke-width="4" stroke-linecap="round"/>
              <path d="M118 236 A52 52 0 0 1 222 236 Z" fill="#fff" stroke-width="6"/><path d="M468 236 A52 52 0 0 1 572 236 Z" fill="#fff" stroke-width="6"/>
              <circle cx="170" cy="240" r="36" fill="#0A1F44"/><circle cx="170" cy="240" r="14" fill="#C9D3E3" stroke="none"/>
              <circle cx="520" cy="240" r="36" fill="#0A1F44"/><circle cx="520" cy="240" r="14" fill="#C9D3E3" stroke="none"/>
            </g>
            <g font-family="Hanken Grotesk Variable, Hanken Grotesk, system-ui, sans-serif" font-weight="600" font-size="20" fill="#0A1F44" paint-order="stroke" stroke="#F3F5F8" stroke-width="7" stroke-linejoin="round">
              <text x="720" y="66" text-anchor="middle">Ridge</text><text x="896" y="110">Rafter</text>
              <text x="1060" y="122" text-anchor="middle">On-site weld</text><text x="1082" y="272">Column</text>
              <text x="1082" y="352">Base plate</text><text x="460" y="398" text-anchor="middle">Wall panels going up</text>
              <text x="184" y="398" text-anchor="middle">The van, on site</text>
            </g>
          </svg>
        </div>
        <p style="margin-top:16px;color:var(--body);max-width:88ch"><strong>The van:</strong> 2025 Mercedes-Benz eSprinter, all-electric. 170 in wheelbase, high roof{biz.van.cargoHeight && `, ${biz.van.cargoHeight.replace(' inches', ' in')} standing height`}{biz.van.cargoVolume && `, ${biz.van.cargoVolume.replace(' cubic feet', ' cu ft')}`}, up to 3 pallets or 2,300 lb.</p>
        <p style="margin-top:10px;color:var(--body);max-width:88ch">{biz.owner.note || `${biz.owner.name} builds steel frames and metal buildings, welds on site, and hauls materials for businesses across ${biz.area.summary}.`}</p>
      </div>
    </section>

    {services.length > 0 && (
      <section id="services" class="band">
        <div class="w">
          <h2 class="h2">Trade services</h2>
          <ul class="rows" style="list-style:none;padding:0;margin-bottom:0">
            {services.map((s) => (
              <li class="row">
                <h3>{s.name}</h3>
                {priceText(s.price) && <p class="price">{priceText(s.price)}</p>}
                {s.description && <p class="desc">{s.description}</p>}
                {s.action === 'book' && bookUrl(s)
                  ? <a class="textbtn" href={bookUrl(s)}>Book this</a>
                  : hasForm && <a class="textbtn" href={quoteHref} data-service={s.name}>Get a quote for this</a>}
              </li>
            ))}
          </ul>
          <p style="margin-top:20px;color:var(--body)">Need freight moved for your business? <a href={freight.path} style="font-weight:600">See {freight.name}</a></p>
        </div>
      </section>
    )}

    {biz.plans.length > 0 && (
      <section id="plans" class="band navy">
        <div class="w">
          <h2 class="h2">Care plans</h2>
          <ul class="cols" style="--min:280px;list-style:none;padding:0;margin-top:28px">
            {biz.plans.map((p) => {
              const href = p.signupUrl || (hasForm ? quoteHref : '');
              return (
                <li class="card" style="color:var(--navy);display:flex;flex-direction:column;gap:8px">
                  <h3 style="font-size:22px;font-weight:700">{p.name}</h3>
                  <p style="font-size:20px;font-weight:700">{p.price}</p>
                  <p style="color:var(--body)">{p.description}</p>
                  <ul style="padding-left:18px;color:var(--body)">{p.includes.map((i) => <li>{i}</li>)}</ul>
                  {href && <a class="b b-cta" style="margin-top:auto" href={href} data-service={p.signupUrl ? undefined : p.name}>Sign up</a>}
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <section id="pricing" class="band gray">
      <div class="w">
        <h2 class="h2">Pricing</h2>
        <div class="tiles">
          {biz.faq.minimum && <div><p class="k">Minimum</p><p class="v">2 hours on hourly jobs</p><p>Junk removal from $150</p></div>}
          {biz.faq.travelFee && <div><p class="k">Travel</p><p class="v">Free within 30 miles</p><p>$75 trip fee beyond that</p></div>}
          {biz.faq.payment && <div><p class="k">Payment</p><p class="v">{biz.faq.payment.replace(/\.$/, '')}</p></div>}
          {biz.faq.extras && <div><p class="k">Dump fees</p><p class="v">At cost</p><p>With the receipt</p></div>}
        </div>
        <p style="margin-top:18px;color:var(--body);max-width:80ch">Each service’s rate is listed above. Your rate and any trip fee are confirmed before booking. Long runs across Texas are quoted by the trip, including drive time.</p>
      </div>
    </section>

    {(biz.photos.gallery.length > 0 || biz.photos.videos.length > 0) && (
      <section id="work" class="band">
        <div class="w">
          <h2 class="h2">Recent work</h2>
          {biz.photos.videos.length > 0 && (
            <ul class="vids" style="list-style:none;padding:0">
              {biz.photos.videos.map((v) => (
                <li>
                  <video muted loop playsinline preload="none" data-poster={v.poster} width="540" height="960" aria-label={v.caption}>
                    <source src={v.src} type="video/mp4" />
                  </video>
                  <noscript><img src={v.poster} alt={v.caption} width="540" height="960" loading="lazy" style="width:100%;height:auto;border-radius:10px" /></noscript>
                </li>
              ))}
            </ul>
          )}
          {feature && (
            <ul class="gallery" style="list-style:none;padding:0">
              <li class="wide"><img src={feature.src} alt={feature.caption} width={feature.width} height={feature.height} loading="lazy" decoding="async" /></li>
              {rest.map((g, i) => (
                <li class={rest.length % 2 === 1 && i === rest.length - 1 ? 'wide-sm' : ''}><img src={g.src} alt={g.caption} width={g.width} height={g.height} loading="lazy" decoding="async" /></li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <section id="how" class="band gray">
      <div class="w">
        <h2 class="h2">How it works</h2>
        <ol class="steps">
          <li><span class="n" aria-hidden="true">1</span><h3>Tell us what you need</h3><p>{sentence([biz.links.booking && 'book online', biz.phone && 'call or text', hasForm && 'answer a few quick questions'].filter(Boolean) as string[])}</p></li>
          <li><span class="n" aria-hidden="true">2</span><h3>Get your rate up front</h3><p>Photos help give a faster, more accurate number.</p></li>
          <li><span class="n" aria-hidden="true">3</span><h3>We come to you</h3><p>{biz.owner.name ? biz.owner.name.split(' ')[0] : 'We'} brings the van and the tools and gets to work.</p></li>
        </ol>
      </div>
    </section>

    {faq.length > 0 && (
      <section id="faq" class="band">
        <div class="w cols" style="--min:340px;align-items:start">
          <h2 class="h2">Common questions</h2>
          <div class="faq">
            {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
          </div>
        </div>
      </section>
    )}

    {hasForm && (
      <section id="quote" class="band gray">
        <div class="w cols" style="--min:380px;align-items:start">
          <div style="display:flex;flex-direction:column;gap:18px">
            <h2 style="font-size:clamp(30px,3.6vw,46px);line-height:1.06">Get a quote</h2>
            <p class="lede" style="font-size:18px;max-width:44ch">Answer a few quick questions, or text photos of the job.</p>
            <dl class="spec">
              {biz.phone && <div><dt>Call or text</dt><dd><a href={telHref} style="font-weight:600;text-decoration:none">{phoneDisplay()}</a></dd></div>}
              {biz.email && <div><dt>Email</dt><dd><a href={`mailto:${biz.email}`}>{biz.email}</a></dd></div>}
              {hours && <div><dt>Hours</dt><dd>{hours}. {biz.hoursNote}</dd></div>}
            </dl>
          </div>
          <div>
            <QuoteForm scan={scan} />
            {biz.phone && <p style="margin-top:12px"><a class="b b-line" href={photosHref}><Icon name="text" />Text me photos instead</a></p>}
          </div>
        </div>
      </section>
    )}
  </main>

  <footer class="foot">
    <div class="w">
      <div class="cols" style="--min:220px;gap:32px 40px">
        <div class="col" style="gap:14px">
          {biz.logo && <img src={biz.logo} alt="" width="510" height="423" loading="lazy" style="width:96px;height:auto;background:#fff;border-radius:8px;padding:4px" />}
          <p style="max-width:34ch">{biz.headline} across {biz.area.summary}. {biz.area.note}</p>
        </div>
        <div class="col">
          <h3>Contact</h3>
          {biz.phone && <a href={telHref}>{phoneDisplay()}, call or text</a>}
          {biz.phone && <a href="/contact.vcf">Save my number</a>}
          {biz.email && <a href={`mailto:${biz.email}`} style="overflow-wrap:anywhere">{biz.email}</a>}
          {hours && <span>{hours}</span>}
        </div>
        <div class="col" id="area">
          <h3>Service area</h3>
          {biz.area.summary && <span>{biz.area.summary.replace(/^the /, 'The ')}</span>}
          {biz.area.places.map((p) => <span>{p}</span>)}
          {biz.area.note && <span>{biz.area.note}</span>}
          <span>Statewide by arrangement</span>
        </div>
        <div class="col">
          <h3>Company</h3>
          <a href={freight.path}>Freight delivery by {freight.name}</a>
          <a href="#services">Trade services</a>
          <a href="#pricing">Pricing</a>
          {hasForm && <a href="#quote">Get a quote</a>}
          <a href="/privacy">Privacy</a>
        </div>
      </div>
      <div class="legal">
        <span>© {year} {name}. Owner: {biz.owner.name}.</span>
        <span>{usdot() && <><a href={saferUrl()} rel="noopener" style="text-decoration:underline">USDOT {usdot()}</a>.</>} {biz.credentials.insurance && `${biz.credentials.insurance}.`}</span>
      </div>
    </div>
  </footer>

  {(biz.phone || hasForm) && (
    <nav class="bar" aria-label="Contact">
      {biz.phone && <a class="b b-line" href={telHref}><Icon name="call" />Call</a>}
      {biz.phone && <a class="b b-line" href={textHref}><Icon name="text" />Text</a>}
      {biz.links.booking ? <a class="b b-cta" href={biz.links.booking}><Icon name="book" />Book</a> : hasForm && <a class="b b-cta" href={quoteHref}><Icon name="quote" />Quote</a>}
    </nav>
  )}
  {biz.photos.videos.length > 0 && (
    <script is:inline>
      // Videos loop silently while on screen, with no player controls, and only download once close to it.
      // Tap (or Enter/Space) pauses or plays a clip. If a phone blocks autoplay (e.g. Low Power Mode) or the
      // visitor asked for less motion, the clip shows its still frame and starts on a tap.
      (function () {
        var vids = [].slice.call(document.querySelectorAll('video[data-poster]'));
        var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
        function cover(v) { if (!v.poster) v.poster = v.getAttribute('data-poster'); }
        function toggle(v) {
          if (v.paused) { v.removeAttribute('data-held'); v.muted = true; v.play(); } else { v.pause(); v.setAttribute('data-held', ''); }
        }
        vids.forEach(function (v) {
          v.setAttribute('tabindex', '0');
          v.setAttribute('aria-label', v.getAttribute('aria-label') + '. Tap to pause or play.');
          v.addEventListener('click', function () { toggle(v); });
          v.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(v); } });
        });
        if (calm || !('IntersectionObserver' in window)) { vids.forEach(function (v) { cover(v); v.setAttribute('data-held', ''); }); return; }
        var near = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { cover(e.target); near.unobserve(e.target); } });
        }, { rootMargin: '400px' });
        var seen = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            var v = e.target;
            if (!e.isIntersecting) { v.pause(); return; }
            if (v.hasAttribute('data-held')) return;
            v.muted = true;
            var p = v.play();
            // Autoplay blocked: keep the still frame; a tap plays it.
            if (p && p.catch) p.catch(function () { cover(v); v.setAttribute('data-held', ''); });
          });
        }, { threshold: 0.25 });
        vids.forEach(function (v) { near.observe(v); seen.observe(v); });
      })();
    </script>
  )}
</Brand>
