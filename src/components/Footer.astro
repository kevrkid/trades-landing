---
import { biz, telHref, smsHref, phoneDisplay } from '../lib/derive.ts';
const licenses = biz.credentials.licenses;
---
<footer class="bg-deep text-white sec">
  <div class="wrap grid gap-3">
    {biz.name && <p class="display text-3xl">{biz.name}</p>}
    {biz.phone && (
      <p class="flex flex-wrap gap-x-5">
        <a class="textlink" href={telHref}>Call {phoneDisplay()}</a>
        <a class="textlink" href={smsHref()}>Text me</a>
        <a class="textlink" href="/contact.vcf">Save my number</a>
      </p>
    )}
    {biz.email && <p><a class="textlink" href={`mailto:${biz.email}`}>{biz.email}</a></p>}
    {biz.hours.length > 0 && <p>{biz.hours.map((h) => `${h.days} ${h.time}`).join(' · ')}</p>}
    {biz.area.summary && <p>Serving {biz.area.summary}</p>}
    {licenses.length > 0 && <p>{licenses.map((l) => `${l.label} #${l.number}`).join(' · ')}</p>}
    {biz.socials.length > 0 && <p class="flex flex-wrap gap-x-5">{biz.socials.map((s) => <a class="textlink" href={s.url} rel="noopener">{s.label}</a>)}</p>}
    <p class="flex flex-wrap gap-x-5"><a class="textlink" href="/delivery">Business delivery</a><a class="textlink" href="/privacy">Privacy</a></p>
  </div>
</footer>
