---
// Everything inside <head> except the stylesheets. Shared by Base (home, /van) and SiteLayout (delivery pages).
import { biz, isSample, siteUrl, todos } from '../lib/derive.ts';

interface Props {
  title: string; description: string; canonicalPath?: string; noindex?: boolean;
  ld?: Record<string, unknown> | Record<string, unknown>[] | null; fontUrl: string; ogImage?: string; themeColor: string;
}
const { title, description, canonicalPath, noindex = false, ld = null, fontUrl, ogImage = '/og.png', themeColor } = Astro.props;
const url = siteUrl();
const canonical = url && canonicalPath ? url + (canonicalPath === '/' ? '/' : canonicalPath) : '';
const lds = ld ? (Array.isArray(ld) ? ld : [ld]) : [];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{(noindex || isSample || todos().some((t) => t.blocker)) && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
<meta name="theme-color" content={themeColor} />
<link rel="icon" href="/favicon.png" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{biz.name && <meta property="og:site_name" content={biz.name} />}
{canonical && <meta property="og:url" content={canonical} />}
{url && <meta property="og:image" content={url + ogImage} />}
{url && <meta property="og:image:width" content="1200" />}
{url && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content="summary_large_image" />
{lds.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)}></script>)}
{biz.cloudflareAnalyticsToken && !isSample && (
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: biz.cloudflareAnalyticsToken })}></script>
)}
